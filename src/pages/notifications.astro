---
/**
 * Notification mockup — "phone reveal" for the Coach ad.
 * Script: Coach was watching a rom-com on the couch. Ironic contrast — performance coach being non-performant.
 * Tagline: UWC: it's okay to be human.
 */
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Notifications — Altus Peak Coaching</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            teal: '#2DD4BF',
            dark: '#0F1419',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-dark min-h-screen text-white">
  <!-- Status Bar Mockup -->
  <div class="flex items-center justify-between px-6 py-2 text-xs text-white/60">
    <span>8:45 PM</span>
    <div class="flex items-center gap-1"><span>5G</span><span>📶</span><span>🔋 64%</span></div>
  </div>

  <!-- App Header -->
  <div class="px-6 pt-4 pb-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-white/50">Good evening</p>
        <h1 class="text-2xl font-bold">Altus Peak Coaching</h1>
      </div>
      <div class="relative">
        <div class="w-10 h-10 rounded-full bg-teal/20 flex items-center justify-center text-lg">🧭</div>
        <div class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-red-500 flex items-center justify-center text-[10px] font-bold">8</div>
      </div>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="px-6 grid grid-cols-3 gap-3 mb-6">
    <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center">
      <p class="text-2xl font-bold text-teal">5</p>
      <p class="text-[10px] text-white/50 mt-1">Discovery Calls</p>
    </div>
    <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center">
      <p class="text-2xl font-bold text-green-400">$1,050</p>
      <p class="text-[10px] text-white/50 mt-1">Package Sold</p>
    </div>
    <div class="bg-white/5 border border-white/10 rounded-xl p-3 text-center">
      <p class="text-2xl font-bold text-blue-400">3</p>
      <p class="text-[10px] text-white/50 mt-1">AI Chats</p>
    </div>
  </div>

  <!-- Timeline -->
  <div class="px-6">
    <h2 class="text-sm font-semibold text-white/40 uppercase tracking-wider mb-4">While you were away</h2>
    <div class="space-y-3">
      <div class="bg-white/5 border border-white/10 rounded-xl p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-sm">💳</div>
            <div>
              <p class="text-sm font-medium">Sarah L. booked a VIP Intensive — $1,500</p>
              <p class="text-xs text-white/40">Full-day session · via Stripe</p>
            </div>
          </div>
          <span class="text-[10px] text-white/30">12m ago</span>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-teal/20 flex items-center justify-center text-sm">🤖</div>
            <div>
              <p class="text-sm font-medium">AI matched James R. to the 6-Session Package</p>
              <p class="text-xs text-white/40">He purchased · $1,050 confirmed</p>
            </div>
          </div>
          <span class="text-[10px] text-white/30">25m ago</span>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-sm">💬</div>
            <div>
              <p class="text-sm font-medium">AI answered "What's the difference between coaching and therapy?"</p>
              <p class="text-xs text-white/40">Prospect stayed 6 minutes · booked discovery call</p>
            </div>
          </div>
          <span class="text-[10px] text-white/30">40m ago</span>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-teal/20 flex items-center justify-center text-sm">📅</div>
            <div>
              <p class="text-sm font-medium">2 discovery calls booked for next week</p>
              <p class="text-xs text-white/40">Tuesday 10am · Thursday 3pm</p>
            </div>
          </div>
          <span class="text-[10px] text-white/30">1h ago</span>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-xl p-4">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-sm">💬</div>
            <div>
              <p class="text-sm font-medium">AI walked a prospect through the free resource download</p>
              <p class="text-xs text-white/40">Downloaded the Mindset Toolkit · subscribed to email list</p>
            </div>
          </div>
          <span class="text-[10px] text-white/30">1.5h ago</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Summary -->
  <div class="px-6 py-8 mt-4">
    <div class="bg-teal/10 border border-teal/20 rounded-xl p-5 text-center">
      <p class="text-teal text-sm font-medium">5 prospects became clients while you binged Season 3.</p>
      <p class="text-white/50 text-xs mt-1">5 discovery calls · 3 AI conversations · $1,050 in revenue</p>
    </div>
  </div>

  <!-- UWC Branding -->
  <div class="fixed bottom-0 left-0 right-0 bg-gradient-to-t from-dark via-dark/80 to-transparent py-6 px-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-white text-lg font-bold">UWC</p>
        <p class="text-teal text-sm">It's okay to be human.</p>
      </div>
      <p class="text-white/30 text-xs">upstate-web.com</p>
    </div>
  </div>
</body>
</html>
