---
import Layout from '../layouts/Layout.astro'
import { SITE, SERVICES, TESTIMONIALS, FREE_RESOURCE } from '../lib/config'
---

<Layout>
  <!-- Hero -->
  <section class="relative h-[65vh] flex items-center overflow-hidden">
    <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1200&q=75&auto=format" alt="Executive coaching session" class="absolute inset-0 w-full h-full object-cover brightness-[0.3]" loading="eager" width="1200" height="800" fetchpriority="high" />
    <div class="relative px-6 mx-auto max-w-6xl">
      <div class="max-w-xl">
        <h1 class="text-4xl md:text-5xl text-white leading-tight" style="font-family: Georgia, serif;">You're a great leader.<br/>Let's make you an <span class="text-teal-light">exceptional</span> one.</h1>
        <p class="mt-4 text-lg text-white/80">Executive coaching for leaders who want clarity, not just advice.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={SITE.bookingUrl} class="rounded-lg bg-teal px-6 py-3 text-center font-medium text-white hover:bg-teal-dark transition-colors">Book a Free Discovery Call</a>
          <a href="#services" class="rounded-lg border border-white/30 px-6 py-3 text-center font-medium text-white hover:bg-white/10 transition-colors">See Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Chat -->
  <section class="bg-cream py-6 px-6">
    <div class="mx-auto max-w-xl">
      <div id="chat-container" class="rounded-xl border border-teal/20 bg-white overflow-hidden">
        <div id="chat-messages" class="hidden max-h-80 overflow-y-auto px-4 pt-4 pb-2 space-y-3"></div>
        <div id="chat-input-bar" class="flex gap-2 p-3">
          <input id="chat-input" type="text" placeholder="What's executive coaching? How does it work? What are your rates?" class="flex-1 rounded-lg border border-teal/20 bg-cream px-5 py-2.5 text-sm placeholder:text-muted focus:border-teal focus:outline-none" />
          <button id="chat-send" class="rounded-lg bg-teal px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-dark transition-colors">Ask</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-20 px-6">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold text-center mb-2">Services & Investment</h2>
      <p class="text-center text-muted text-sm mb-10">Clear pricing. No surprises. Every engagement starts with a free discovery call.</p>
      <div class="grid md:grid-cols-2 gap-5">
        {SERVICES.map((s) => (
          <div class={`rounded-xl p-6 ${s.popular ? 'border-2 border-teal bg-teal/5' : 'border border-teal/10 bg-white'}`}>
            {s.popular && <p class="text-xs font-medium text-teal uppercase tracking-wide mb-2">Most Popular</p>}
            <h3 class="text-lg font-semibold">{s.name}</h3>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-xl font-bold text-teal">{s.price}</span>
              <span class="text-xs text-muted">{s.duration}</span>
            </div>
            <p class="text-sm text-muted mt-3 leading-relaxed">{s.description}</p>
            <a href={SITE.bookingUrl} class={`block mt-5 text-center rounded-lg py-2.5 text-sm font-medium transition-colors ${s.popular ? 'bg-teal text-white hover:bg-teal-dark' : 'border border-teal/20 text-teal hover:bg-teal/5'}`}>
              Book Discovery Call
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="py-20 px-6 bg-cream">
    <div class="mx-auto max-w-4xl grid md:grid-cols-2 gap-10 items-center">
      <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=600&q=80" alt="Dr. Maya Chen" class="rounded-xl aspect-[4/5] object-cover" loading="lazy" />
      <div>
        <h2 class="text-3xl font-semibold mb-4">Meet Maya</h2>
        <p class="text-muted leading-relaxed mb-4">
          I've spent 15 years in leadership development — first as a VP at a Fortune 500, then as an executive coach working with founders, directors, and C-suite leaders.
        </p>
        <p class="text-muted leading-relaxed mb-4">
          I don't give advice. I ask the questions that help you see what you already know. My clients tell me our sessions are the one hour a week where they actually think clearly.
        </p>
        <p class="text-muted leading-relaxed mb-4">
          Certifications: Professional Certified Coach (PCC), certified stakeholder coaching methodology, PhD Organizational Psychology.
        </p>
        <a href={SITE.bookingUrl} class="inline-block rounded-lg bg-teal px-5 py-2.5 text-sm font-medium text-white hover:bg-teal-dark transition-colors">
          Let's talk
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="py-20 px-6">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold text-center mb-10">What Leaders Say</h2>
      <div class="grid md:grid-cols-3 gap-5">
        {TESTIMONIALS.map((t) => (
          <div class="rounded-xl border border-teal/10 bg-white p-6">
            <p class="text-sm italic text-charcoal leading-relaxed">"{t.quote}"</p>
            <div class="mt-4 pt-4 border-t border-teal/10">
              <p class="text-sm font-medium">{t.author}</p>
              <p class="text-xs text-muted">{t.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Free Resource -->
  <section id="resource" class="py-16 px-6 bg-teal text-center">
    <div class="mx-auto max-w-lg">
      <p class="text-teal-light text-sm uppercase tracking-wide mb-3">Free Guide</p>
      <h2 class="text-2xl font-semibold text-white">{FREE_RESOURCE.title}</h2>
      <p class="text-white/80 text-sm mt-3">{FREE_RESOURCE.description}</p>
      <form id="resource-form" class="mt-6 flex gap-2 max-w-sm mx-auto">
        <input type="email" name="email" placeholder="Your email" required class="flex-1 rounded-lg bg-white/10 border border-white/20 px-4 py-2.5 text-sm text-white placeholder:text-white/50 focus:border-white/50 focus:outline-none" />
        <button type="submit" class="rounded-lg bg-white text-teal-dark px-5 py-2.5 text-sm font-medium hover:bg-white/90">Get the Guide</button>
      </form>
      <div id="resource-status" class="hidden mt-3 text-sm text-white/80"></div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 px-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-semibold text-center mb-10">How It Works</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-teal text-white flex items-center justify-center font-bold text-sm">1</div>
          <div>
            <h3 class="font-semibold">Free Discovery Call (30 min)</h3>
            <p class="text-sm text-muted mt-1">We talk about where you are, where you want to be, and whether coaching is the right move. No pitch — just a conversation.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-teal text-white flex items-center justify-center font-bold text-sm">2</div>
          <div>
            <h3 class="font-semibold">Choose Your Path</h3>
            <p class="text-sm text-muted mt-1">Single sessions, 6-session package, or VIP intensive. We pick what fits your timeline and goals.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-full bg-teal text-white flex items-center justify-center font-bold text-sm">3</div>
          <div>
            <h3 class="font-semibold">Do the Work</h3>
            <p class="text-sm text-muted mt-1">Sessions via Zoom or in person. Email support between sessions. Honest conversations that change how you lead.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 px-6 bg-cream text-center">
    <h2 class="text-2xl font-semibold">Ready for clarity?</h2>
    <p class="text-muted text-sm mt-2 max-w-md mx-auto">The first call is free. No commitment. Just 30 minutes to see if this is right for you.</p>
    <a href={SITE.bookingUrl} class="inline-block mt-6 rounded-lg bg-teal px-8 py-3 font-medium text-white hover:bg-teal-dark transition-colors">Book Your Free Call</a>
  </section>

  <script>
    document.getElementById('resource-form')?.addEventListener('submit', (e) => {
      e.preventDefault()
      const status = document.getElementById('resource-status')!
      status.textContent = 'Check your inbox — the guide is on its way!'
      status.classList.remove('hidden')
      ;(e.target as HTMLFormElement).querySelectorAll('input, button').forEach(el => (el as HTMLInputElement).disabled = true)
    })

    // Multi-turn AI chat
    const chatInput = document.getElementById('chat-input') as HTMLInputElement
    const chatSend = document.getElementById('chat-send')!
    const chatMessages = document.getElementById('chat-messages')!
    let chatHistory: Array<{ role: string; content: string }> = []
    let chatBusy = false

    function addMessage(role: string, text: string) {
      chatMessages.classList.remove('hidden')
      const wrapper = document.createElement('div')
      wrapper.className = role === 'user' ? 'flex justify-end' : 'flex justify-start'
      const bubble = document.createElement('div')
      bubble.className = role === 'user'
        ? 'bg-teal text-white rounded-2xl rounded-br-sm px-4 py-2 max-w-[80%] text-sm'
        : 'bg-cream rounded-2xl rounded-bl-sm px-4 py-2 max-w-[80%] text-sm leading-relaxed'
      bubble.textContent = text
      wrapper.appendChild(bubble)
      chatMessages.appendChild(wrapper)
      chatMessages.scrollTop = chatMessages.scrollHeight
    }

    function showTyping() {
      const el = document.createElement('div')
      el.id = 'typing-indicator'
      el.className = 'flex justify-start'
      el.innerHTML = '<div class="bg-cream text-muted rounded-2xl rounded-bl-sm px-4 py-2 text-sm">Thinking...</div>'
      chatMessages.appendChild(el)
      chatMessages.scrollTop = chatMessages.scrollHeight
    }

    async function sendMessage() {
      const text = chatInput.value.trim()
      if (!text || chatBusy) return
      chatBusy = true
      chatInput.value = ''
      addMessage('user', text)
      showTyping()
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, history: chatHistory }),
        })
        const data = await res.json()
        document.getElementById('typing-indicator')?.remove()
        const reply = data.reply || "I'm not sure — email Maya directly!"
        addMessage('assistant', reply)
        chatHistory.push({ role: 'user', content: text })
        chatHistory.push({ role: 'assistant', content: reply })
        if (chatHistory.length > 20) chatHistory = chatHistory.slice(-20)
      } catch {
        document.getElementById('typing-indicator')?.remove()
        addMessage('assistant', 'Something went wrong. Email maya@altuspeakcoaching.com!')
      }
      chatBusy = false
    }

    chatSend.addEventListener('click', sendMessage)
    chatInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendMessage() })
  </script>
</Layout>
